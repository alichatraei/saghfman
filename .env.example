# ---------- Database ----------
DATABASE_URL="postgresql://saghf:saghf_password@localhost:5432/saghf_man?schema=public"

# ---------- API ----------
API_PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000"

# ---------- Auth ----------
JWT_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
COOKIE_DOMAIN="localhost"

# ---------- SMS ----------
# mock | kavenegar | smsir | melipayamak
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER=""
SMS_TEMPLATE="saghfman-otp"

# ---------- Uploads ----------
UPLOAD_PATH="./uploads"
MAX_IMAGES_PER_PROPERTY=15
MAX_IMAGE_SIZE_MB=8

# ---------- Company defaults (seeded into CompanySetting) ----------
COMPANY_NAME="سقف من"
COMPANY_DEFAULT_PHONE="021-91001234"
COMPANY_SECONDARY_PHONE="021-91001235"
COMPANY_WHATSAPP="989120000000"
COMPANY_WORKING_HOURS="همه‌روزه از ۹ صبح تا ۹ شب"

# ---------- Web ----------
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="سقف من"
