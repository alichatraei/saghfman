# ---------------------------------------------------------------
#  نمونه .env برای استقرار با Docker Compose
#  روی سرور: cp .env.production.example .env  و مقادیر را پر کنید.
#  این فایل هرگز نباید در گیت commit شود.
# ---------------------------------------------------------------

# ---------- PostgreSQL (فقط برای docker-compose.prod.yml) ----------
POSTGRES_USER=saghf
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=saghf_man

# DATABASE_URL توسط compose ساخته می‌شود و نیازی به تعریف دستی ندارد،
# ولی برای اجرای دستور‌های prisma خارج از کانتینر مفید است:
DATABASE_URL="postgresql://saghf:CHANGE_ME_STRONG_PASSWORD@db:5432/saghf_man?schema=public"

# ---------- API ----------
NODE_ENV=production
API_PORT=4000
TZ=Asia/Tehran
CORS_ORIGINS="https://example.com,https://www.example.com"

# ---------- Auth ----------
# هر دو را با openssl rand -base64 48 بسازید.
JWT_SECRET="CHANGE_ME_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_ANOTHER_32_CHARS"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
COOKIE_DOMAIN="example.com"

# ---------- SMS ----------
# در production حتماً از mock خارج شوید.
SMS_PROVIDER="kavenegar"
SMS_API_KEY=""
SMS_SENDER=""
SMS_TEMPLATE="saghfman-otp"

# ---------- Uploads ----------
UPLOAD_PATH="./uploads"
MAX_IMAGES_PER_PROPERTY=15
MAX_IMAGE_SIZE_MB=8

# ---------- اطلاعات شرکت (فقط مقدار اولیه seed) ----------
COMPANY_NAME="سقف من"
COMPANY_DEFAULT_PHONE="031-00000000"
COMPANY_SECONDARY_PHONE=""
COMPANY_WHATSAPP=""
COMPANY_WORKING_HOURS="همه‌روزه از ۹ صبح تا ۹ شب"

# ---------- وب (در زمان بیلد داخل باندل نوشته می‌شوند) ----------
NEXT_PUBLIC_API_URL="https://example.com/api"
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_SITE_NAME="سقف من"
